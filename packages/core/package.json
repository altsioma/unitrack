{
  "name": "@unitrack/core",
  "version": "0.2.0",
  "description": "Headless, plugin-based music player core",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
